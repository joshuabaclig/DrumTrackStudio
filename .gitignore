# Python virtual environment - large & platform-specific, rebuild with Setup.ps1
env/

# Third-party binaries - downloaded locally by Setup.ps1, not committed
bin/*.exe

# Build outputs - produced by Build-Exe.ps1 / Build-Runtime.ps1 / Build-Installer.ps1
DrumTrackStudio.exe
runtime/
dist/
checksums.txt

# Personal audio - never share your downloaded/generated tracks
Downloads/*
!Downloads/.gitkeep
Stems/*
!Stems/.gitkeep

# Reaper peak cache files
*.reapeaks

# Pipeline status/log files
*.log
dts_status_*.txt
dts_path_*.txt
